{
  "manifest_version": 3,
  "name": "Central de Acionamentos",
  "version": "0.2.0",
  "description": "Junta os chamados dos portais de assistência numa tela só e toca alarme quando entra serviço novo.",
  "key": "",
  "icons": {
    "16": "icones/icone16.png",
    "32": "icones/icone32.png",
    "48": "icones/icone48.png",
    "128": "icones/icone128.png"
  },
  "action": {
    "default_title": "Abrir a Central de Acionamentos",
    "default_icon": {
      "16": "icones/icone16.png",
      "32": "icones/icone32.png"
    }
  },
  "background": {
    "service_worker": "fundo.js"
  },
  "permissions": [
    "storage",
    "notifications",
    "offscreen",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.portoseguro.com.br/*",
        "*://tms-prestador.tokiomarine.com.br/*",
        "*://hub.notro.io/*",
        "*://*.acionafacil.com.br/*"
      ],
      "js": [
        "leitor.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
